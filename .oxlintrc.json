{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/aria-role": ["error", { "ignoreNonDOM": true }],
    "jsx-a11y/prefer-tag-over-role": "off",
    "import/no-cycle": "error",
    "import/no-unassigned-import": "off",
    "typescript/no-explicit-any": "error",
    "typescript/no-extraneous-class": ["warn", { "allowWithDecorator": true }],
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-underscore-dangle": ["warn", { "allow": ["_count", "_all"] }]
  },
  "ignorePatterns": ["server/generated/**", "dist/**", "src/components/ui/**"],
  "overrides": [
    {
      "files": ["prisma/**", "server/openapi-export.ts"],
      "rules": { "no-console": "off" }
    },
    {
      "files": ["**/*.d.ts"],
      "rules": { "unicorn/require-module-specifiers": "off" }
    }
  ]
}
