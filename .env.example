# PostgreSQL из docker-compose.yml (npm run db:up)
DATABASE_URL="postgresql://afisha:afisha@localhost:5433/afisha?schema=public"
# Отдельная база для интеграционных тестов: npm run test:e2e пересоздаёт в ней данные
TEST_DATABASE_URL="postgresql://afisha:afisha@localhost:5433/afisha_test?schema=public"

# Секрет подписи JWT, не короче 32 символов.
JWT_SECRET="change-me-to-a-long-random-string"
# Время жизни access token в секундах
JWT_EXPIRES_IN=900

# Порт API
PORT=3000
# Сколько обратных прокси (nginx, балансировщик) стоит перед API. 0 — API смотрит в интернет напрямую.
# Без верного значения лимит на вход считает всех посетителей одним IP
TRUST_PROXY=0
# Как часто закончившиеся события переводятся в архив, в секундах
ARCHIVE_INTERVAL_SECONDS=300
# Кэш публичной афиши в памяти процесса, в секундах; 0 — выключен
PUBLIC_CACHE_TTL_SECONDS=10

# Адреса фронтенда, которым разрешено обращаться к API (через запятую)
CORS_ORIGINS="http://localhost:5173"
