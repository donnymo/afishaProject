{
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "composite": false,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.build.tsbuildinfo",
    "rootDir": "./server",
    "outDir": "./dist/server",
    "removeComments": true,
    "types": ["node"]
  },
  "include": ["server"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
