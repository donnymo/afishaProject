    "/events": {
      "get": {
        "description": "Только опубликованные и ещё не закончившиеся события. Фильтры комбинируются через AND, категории внутри фильтра — через OR. Неизвестные параметры и поле сортировки отклоняются с 400.",
        "operationId": "EventsController_list",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 200,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "Начало диапазона (ISO 8601). Дата без времени — начало дня по Москве. Попадают события, которые ещё идут в этот момент.",
            "schema": {
              "example": "2026-10-10",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "Конец диапазона (ISO 8601). Дата без времени — конец дня по Москве.",
            "schema": {
              "example": "2026-10-11",
              "type": "string"
            }
          },
          {
            "name": "category",
            "required": false,
            "in": "query",
            "description": "Слаги категорий через запятую; подходит событие хотя бы с одной из них",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "city",
            "required": false,
            "in": "query",
            "schema": {
              "example": "moscow",
              "type": "string"
            }
          },
          {
            "name": "minPrice",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "example": 0,
              "type": "number"
            }
          },
          {
            "name": "maxPrice",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "example": 1500,
              "type": "number"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "schema": {
              "default": "date",
              "type": "string",
              "enum": [
                "date",
                "price"
              ]
            }
          },
          {
            "name": "order",
            "required": false,
            "in": "query",
            "schema": {
              "default": "asc",
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventPageDto"
                }
              }
            }
          },
          "400": {
            "description": "Неверные параметры, даты или фильтры (VALIDATION_FAILED, EVENT_NOT_READY)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Публичная афиша",
        "tags": [
          "Events"
        ]
      },
      "post": {
        "description": "Обязательно только название; остальное можно заполнить позже.",
        "operationId": "EventsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEventDto"
