          },
          "400": {
            "description": "Неверные параметры, даты или фильтры (VALIDATION_FAILED, EVENT_NOT_READY)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Токен отсутствует, неверен или просрочен (UNAUTHORIZED, TOKEN_EXPIRED, INVALID_CREDENTIALS)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "Недостаточная роль или чужой ресурс (FORBIDDEN_ROLE, FORBIDDEN_NOT_OWNER)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Ресурс не найден или скрыт от вас (EVENT_NOT_FOUND, VENUE_NOT_FOUND, NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "Конфликт состояния (INVALID_STATE_TRANSITION, EVENT_ALREADY_STARTED, EVENT_HIDDEN, EVENT_ARCHIVED, EMAIL_TAKEN)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Изменить поля своего события",
        "tags": [
          "Events"
        ]
      }
    },
