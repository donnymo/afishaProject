  "paths": {
    "/auth/register": {
      "post": {
        "description": "Создаёт пользователя с ролью organizer и сразу выдаёт access token.",
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Неверные параметры, даты или фильтры (VALIDATION_FAILED, EVENT_NOT_READY)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "Конфликт состояния (INVALID_STATE_TRANSITION, EVENT_ALREADY_STARTED, EVENT_HIDDEN, EVENT_ARCHIVED, EMAIL_TAKEN)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "Слишком много попыток, повторите позже (TOO_MANY_REQUESTS); время ожидания — в заголовке Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Регистрация организатора",
        "tags": [
          "Auth"
        ]
      }
    },
