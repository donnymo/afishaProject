  "info": {
    "title": "Афиша Москвы API",
    "description": "Публичная афиша, кабинет организатора и модерация.\n\n**Аутентификация.** POST /auth/login или /auth/register возвращают JWT access token. Передавайте его как `Authorization: Bearer <token>`.\n\n**Пагинация.** Offset: `page` (с 1) и `pageSize` (1–50). Ответ: `{ items, total, page, pageSize }`.\n\n**Ошибки.** Всегда `{ code, message, details, requestId }`: 400 — неверные параметры, 401 — нет или просрочен токен, 403 — не та роль или чужое событие, 404 — нет ресурса, 409 — конфликт состояния.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Студия «Резонанс»",
            "description": "Название организации или имя"
          },
          "email": {
            "type": "string",
            "example": "studio@example.ru"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200,
            "example": "correct-horse-battery"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "organizer",
          "moderator"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT access token, передаётся как Authorization: Bearer <token>"
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "number",
            "example": 900,
            "description": "Срок жизни токена в секундах"
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn",
          "user"
        ]
      },
      "ErrorDetailDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "venueId",
            "description": "Поле запроса, к которому относится проблема"
          },
          "issue": {
            "type": "string",
            "example": "Не выбрана площадка"
          }
        },
        "required": [
          "issue"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "EVENT_NOT_READY",
              "BAD_REQUEST",
              "UNAUTHORIZED",
              "TOKEN_EXPIRED",
              "INVALID_CREDENTIALS",
              "FORBIDDEN_ROLE",
              "FORBIDDEN_NOT_OWNER",
              "NOT_FOUND",
              "EVENT_NOT_FOUND",
              "VENUE_NOT_FOUND",
              "INVALID_STATE_TRANSITION",
              "EVENT_ALREADY_STARTED",
              "EVENT_HIDDEN",
              "EVENT_ARCHIVED",
              "EMAIL_TAKEN",
              "CONFLICT",
              "PAYLOAD_TOO_LARGE",
              "TOO_MANY_REQUESTS",
              "INTERNAL_ERROR"
            ],
            "example": "EVENT_NOT_READY"
          },
          "message": {
            "type": "string",
            "example": "Черновик нельзя опубликовать: заполните обязательные поля"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorDetailDto"
            }
          },
          "requestId": {
            "type": "string",
            "example": "6f1c9a2e-3b7d-4c55-9a51-0e2f7c1d8b44",
            "description": "Совпадает с заголовком X-Request-Id"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "requestId"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "organizer@afisha.local"
          },
          "password": {
            "type": "string",
            "example": "demo-pass-2026"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CategoryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "example": "concert",
            "description": "Используется в фильтре GET /events?category="
          },
          "name": {
            "type": "string",
            "example": "Концерты"
          }
        },
        "required": [
          "id",
          "slug",
          "name"
        ]
      },
      "VenueDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Концертный зал «Северный»"
          },
          "address": {
            "type": "string",
            "example": "Новослободская ул., 24"
          }
        },
        "required": [
          "id",
          "name",
          "address"
        ]
      },
      "CreateVenueDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Клуб «Подвал»"
          },
          "address": {
            "type": "string",
            "example": "ул. Покровка, 3"
          }
        },
        "required": [
          "name",
          "address"
        ]
      },
      "EventStatus": {
        "type": "string",
        "enum": [
          "draft",
          "published",
          "hidden",
          "archived"
        ]
      },
      "EventOwnerDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Студия «Резонанс»"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "EventDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "startsAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "price": {
            "type": "number",
            "nullable": true,
            "description": "Рубли, 0 — бесплатно"
          },
          "ageLimit": {
            "type": "number",
            "nullable": true,
            "enum": [
              0,
              6,
              12,
              16,
              18
            ]
          },
          "city": {
            "type": "string",
            "example": "moscow"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EventStatus"
              }
            ]
          },
          "venue": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/VenueDto"
              }
            ]
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryDto"
            }
          },
          "owner": {
            "$ref": "#/components/schemas/EventOwnerDto"
          },
          "publishedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "hiddenReason": {
            "type": "string",
            "nullable": true,
            "description": "Только для владельца и модератора"
          },
          "hiddenAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "description": "Только для владельца и модератора"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "startsAt",
          "endsAt",
          "price",
          "ageLimit",
          "city",
          "status",
          "venue",
          "categories",
          "owner",
          "publishedAt",
          "createdAt",
          "updatedAt"
        ]
      },
      "EventPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventDto"
            }
          },
          "total": {
            "type": "number",
            "example": 13,
            "description": "Сколько записей подходит под фильтр всего"
          },
          "page": {
            "type": "number",
            "example": 1
          },
          "pageSize": {
            "type": "number",
            "example": 20
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "pageSize"
        ]
      },
      "MyEventCountsDto": {
        "type": "object",
        "properties": {
          "all": {
            "type": "number",
            "example": 7
          },
          "draft": {
            "type": "number",
            "example": 2
          },
          "published": {
            "type": "number",
            "example": 3
          },
          "hidden": {
            "type": "number",
            "example": 1
          },
          "archived": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "all",
          "draft",
          "published",
          "hidden",
          "archived"
        ]
      },
      "ModerationCountsDto": {
        "type": "object",
        "properties": {
          "published": {
            "type": "number",
            "example": 12
          },
          "hidden": {
            "type": "number",
            "example": 2
          }
        },
        "required": [
          "published",
          "hidden"
        ]
      },
      "CreateEventDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Лекция о звукорежиссуре кино",
            "minLength": 3,
            "maxLength": 200
          },
          "description": {
            "type": "object",
            "nullable": true,
            "maxLength": 5000
          },
          "startsAt": {
            "type": "object",
            "nullable": true,
            "format": "date-time",
            "example": "2026-11-02T19:00:00+03:00"
          },
          "endsAt": {
            "type": "object",
            "nullable": true,
            "format": "date-time",
            "example": "2026-11-02T21:00:00+03:00"
          },
          "price": {
            "type": "object",
            "nullable": true,
            "minimum": 0,
            "description": "Рубли, 0 — бесплатно"
          },
          "ageLimit": {
            "type": "number",
            "nullable": true,
            "enum": [
              0,
              6,
              12,
              16,
              18
            ]
          },
          "city": {
            "type": "string",
            "example": "moscow",
            "default": "moscow"
          },
          "venueId": {
            "type": "object",
            "nullable": true,
            "format": "uuid"
          },
          "categoryIds": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "title"
        ]
      },
      "UpdateEventDto": {
        "type": "object",
        "properties": {
          "description": {
            "type": "object",
            "nullable": true,
            "maxLength": 5000
          },
          "startsAt": {
            "type": "object",
            "nullable": true,
            "format": "date-time",
            "example": "2026-11-02T19:00:00+03:00"
          },
          "endsAt": {
            "type": "object",
            "nullable": true,
            "format": "date-time",
            "example": "2026-11-02T21:00:00+03:00"
          },
          "price": {
            "type": "object",
            "nullable": true,
            "minimum": 0,
            "description": "Рубли, 0 — бесплатно"
          },
          "ageLimit": {
            "type": "number",
            "nullable": true,
            "enum": [
              0,
              6,
              12,
              16,
              18
            ]
          },
          "venueId": {
            "type": "object",
            "nullable": true,
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "city": {
            "type": "string",
            "example": "moscow"
          },
          "categoryIds": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "HideEventDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500,
            "example": "Недостоверная цена: на площадке вход платный, в карточке — бесплатно."
          }
        },
        "required": [
          "reason"
        ]
      }
    }
  }
}
